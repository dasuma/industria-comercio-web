# Todas las variables se leen en RUNTIME (sin prefijo NEXT_PUBLIC_): en local
# desde este archivo, en Azure desde los app settings del App Service. Misma
# imagen Docker para todas las ciudades.

# Backend API (sin /ms-pradma: los endpoints ya lo agregan)
BACKEND_URL=https://api.dev.bia.app
APP_NAME=pradma

# Firebase (auth con Google) — proyecto de la ciudad
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# GitHub Packages (para @dasuma/pradma-ui)
# Generar un Personal Access Token con scope read:packages
# https://github.com/settings/tokens
# Exportalo en tu shell (`export NPM_TOKEN=...`): npm lo lee desde .npmrc
NPM_TOKEN=

# Blob storage (PDF upload)
BLOB_URL=https://blitz-blob.azurewebsites.net

# City service (municipality info / shield image)
CITY_URL=https://blitz-city.azurewebsites.net

# Municipality slug used in blob storage paths (e.g. nocaima)
CITY_NAME=
